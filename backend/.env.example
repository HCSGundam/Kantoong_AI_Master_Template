# Contoh isi backend/.env (file ini aman di-upload, TANPA kunci asli)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Keamanan (opsional, nilai bawaan sudah aman) ----------
# Domain web yang boleh memanggil backend (pisahkan dengan koma). Produksi: isi domain asli.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Batas chat per alamat: per menit & per hari. Anggaran panggilan Gemini seluruh pengguna per hari.
CHAT_PER_MINUTE=12
CHAT_PER_DAY=300
AI_DAILY_BUDGET=3000
# Tautan yang boleh muncul di jawaban AI (selain itu dihapus, anti phishing).
ALLOWED_LINK_HOSTS=kantoong.id
# Server produksi di belakang proxy/CDN (Cloudflare, Nginx): isi 1 agar alamat asli pengunjung terbaca.
TRUST_PROXY=0
HOST=127.0.0.1
# Garam acak untuk hash alamat di catatan keamanan (isi teks acak panjang).
LOG_SALT=
